---
import { INSPECTOR, BUSINESS } from '../lib/business.js';

const stats: { value: string; label: string }[] = [];

if (INSPECTOR.yearsExperience) {
  stats.push({ value: `${INSPECTOR.yearsExperience}+`, label: 'Years inspecting Florida homes' });
}

if (INSPECTOR.inspectionsCompleted) {
  stats.push({
    value: `${INSPECTOR.inspectionsCompleted.toLocaleString()}+`,
    label: 'Inspections completed',
  });
}

stats.push(
  { value: '10 yrs', label: 'Environmental consulting in construction' },
  { value: 'Same day', label: 'Report delivery in most cases' },
  { value: '100%', label: 'Inspections performed by the owner' }
);
---

<!-- ====== Inspector Bio Section Start -->
<section
  id="inspector"
  class="scroll-mt-24 bg-white pb-16 pt-16 dark:bg-dark lg:pb-[100px] lg:pt-[100px]"
>
  <div class="container">
    <div class="-mx-4 flex flex-wrap items-center">
      <div class="w-full px-4 lg:w-5/12">
        <div class="mb-10 overflow-hidden rounded-xl lg:mb-0">
          <img
            src={INSPECTOR.photo}
            alt={`${INSPECTOR.name}, owner and licensed home inspector at Above and Beyond Home Solutions`}
            width="750"
            height="1000"
            loading="lazy"
            class="h-auto w-full object-cover"
          />
        </div>
      </div>

      <div class="w-full px-4 lg:w-7/12 lg:pl-12">
        <span class="mb-3 block text-sm font-semibold uppercase tracking-wide text-primary"
          >Meet Your Inspector</span
        >
        <h2
          class="mb-4 text-3xl font-bold leading-tight text-dark dark:text-white sm:text-[40px] sm:leading-[1.2]"
        >
          {INSPECTOR.name}, Owner and Licensed Home Inspector
        </h2>
        <p class="mb-5 text-base leading-relaxed text-body-color dark:text-dark-6">
          When you hire Above and Beyond Home Solutions, you hire a professional.
        </p>
        <p class="mb-5 text-base leading-relaxed text-body-color dark:text-dark-6">
          Every inspection is performed by the owner and operator himself, not passed down to hired
          help. One set of eyes on the roof, in the attic, in the crawlspace and at the electrical
          panel, and the same person writing the report. No rotating subcontractors, no handoffs, no
          gaps between what was seen and what gets documented. The inspector who books your job is
          the one at your door, and the one who picks up the phone when you're reading the findings
          and want something explained in plain terms.
        </p>
        <p class="mb-5 text-base leading-relaxed text-body-color dark:text-dark-6">
          Behind the license is ten years as an environmental consultant in construction: walking
          buildings mid-build and mid-demolition, testing for moisture, mold and air quality, and
          documenting exactly where water went wrong. That background shapes how the work gets done.
          It's the reason the small items get flagged, not just the obvious ones. The hairline stain
          at a ceiling seam. The breaker running warm. The roof detail that starts leaking two rainy
          seasons from now instead of this one.
        </p>
        <p class="mb-8 text-base leading-relaxed text-body-color dark:text-dark-6">
          Based in North Port, with most years spent across SW Florida. Every one of these homes has
          its own weak spots, and we know where to look. Older block construction from the 1970s and
          80s. Roofs replaced after Hurricane Ian. New builds in Wellen Park. Canal-front
          properties. Seasonal homes that sit closed up for months at a time. Service extends
          throughout Southwest Florida, Lee County included, and the standard doesn't change with
          the drive. No inspection gets cut short to make the next appointment. If the attic needs
          another twenty minutes, it gets another twenty minutes.
        </p>

        <ul class="mb-8 grid gap-3 sm:grid-cols-2">
          {
            INSPECTOR.credentials.map((c) => (
              <li class="flex items-start gap-3 text-base text-dark dark:text-white">
                <svg
                  class="mt-1 h-5 w-5 shrink-0 text-primary"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 111.42-1.42L8.5 12.09l6.79-6.8a1 1 0 011.414 0z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{c}</span>
              </li>
            ))
          }
        </ul>

        <div class="mb-8 flex flex-wrap items-center gap-x-8 gap-y-6">
          <a
            href="https://www.bbb.org/us/fl/north-port/profile/home-inspections/above-and-beyond-home-solutions-llc-0653-90436242/#sealclick"
            target="_blank"
            rel="nofollow noopener"
          >
            <img
              src="https://seal-westflorida.bbb.org/seals/blue-seal-250-52-whitetxt-bbb-90436242.png"
              alt="Above and Beyond Home Solutions, LLC BBB Business Review"
              width="250"
              height="52"
              loading="lazy"
              class="h-auto max-w-full"
            />
          </a>

          <div id="mni-membership-639251404828051450"></div>
        </div>

        <div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {
            stats.map((s) => (
              <div class="rounded-lg bg-gray-1 p-4 text-center dark:bg-dark-2">
                <span class="block text-xl font-bold text-dark dark:text-white">{s.value}</span>
                <span class="block text-xs text-body-color dark:text-dark-6">{s.label}</span>
              </div>
            ))
          }
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href="/schedule"
            class="inline-flex items-center justify-center rounded-md bg-primary px-7 py-3 text-base font-medium text-white hover:bg-blue-dark"
          >
            Schedule an Inspection
          </a>
          <a
            href={`tel:${BUSINESS.phone}`}
            class="inline-flex items-center justify-center rounded-md border border-stroke px-7 py-3 text-base font-medium text-dark hover:border-primary hover:text-primary dark:border-dark-3 dark:text-white"
          >
            Call {BUSINESS.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== Inspector Bio Section End -->

<style is:global>
  /* The chamber widget injects its markup after load, so these rules cannot be
     scoped and the container has to hold its own space to avoid layout shift. */
  #mni-membership-639251404828051450 {
    width: 190px;
    min-height: 150px;
  }

  #mni-membership-639251404828051450 .mn-widget-member-name,
  #mni-membership-639251404828051450 .mn-widget-member-text {
    font-size: 0.75rem;
    line-height: 1.25rem;
    color: #637381;
  }

  #mni-membership-639251404828051450 .mn-widget-member-name {
    color: #111928;
  }

  html.dark #mni-membership-639251404828051450 .mn-widget-member-name {
    color: #ffffff;
  }

  html.dark #mni-membership-639251404828051450 .mn-widget-member-text {
    color: #9ca3af;
  }

  #mni-membership-639251404828051450 .mn-widget-member-logo {
    display: inline-block;
    height: 90px;
    width: auto;
  }
</style>

<script
  is:inline
  type="text/javascript"
  src="https://northportchamber.chambermaster.com/Content/Script/Member.js"></script>
<script is:inline type="text/javascript">
  /* `secure: true` is required: left to its own detection the widget builds an
     http:// JSONP URL on any non-https page, which the browser blocks, and the
     seal silently never renders. Harmless in production, which is https anyway.
     Keep these as block comments: the HTML minifier strips newlines, so a //
     comment would comment out this whole script in the production build. */
  new MNI.Widgets.Member('mni-membership-639251404828051450', {
    member: 4374,
    secure: true,
    styleTemplate: '#@id{text-align:center;position:relative}',
  }).create();
</script>
