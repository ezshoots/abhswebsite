---
import { INSPECTOR, BUSINESS } from '../lib/business.js';

const stats = [
  INSPECTOR.yearsExperience ? { value: `${INSPECTOR.yearsExperience}+`, label: 'Years inspecting Florida homes' } : null,
  INSPECTOR.inspectionsCompleted ? { value: `${INSPECTOR.inspectionsCompleted.toLocaleString()}+`, label: 'Inspections completed' } : null,
  { value: 'Same day', label: 'Report delivery in most cases' },
  { value: '100%', label: 'Inspections performed by the owner' },
].filter(Boolean);
---

<!-- ====== Inspector Bio Section Start -->
<section id="inspector" class="scroll-mt-24 bg-white pt-16 pb-16 dark:bg-dark lg:pt-[100px] lg:pb-[100px]">
  <div class="container">
    <div class="-mx-4 flex flex-wrap items-center">
      <div class="w-full px-4 lg:w-5/12">
        <div class="mb-10 overflow-hidden rounded-xl lg:mb-0">
          <img
            src={INSPECTOR.photo}
            alt={`${INSPECTOR.name}, owner and licensed home inspector at Above and Beyond Home Solutions`}
            width="750"
            height="1000"
            loading="lazy"
            class="h-auto w-full object-cover"
          />
        </div>
      </div>

      <div class="w-full px-4 lg:w-7/12 lg:pl-12">
        <span class="mb-3 block text-sm font-semibold uppercase tracking-wide text-primary">Meet Your Inspector</span>
        <h2 class="mb-4 text-3xl font-bold leading-tight text-dark dark:text-white sm:text-[40px] sm:leading-[1.2]">
          {INSPECTOR.name}, Owner and Licensed Home Inspector
        </h2>
        <p class="mb-5 text-base leading-relaxed text-body-color dark:text-dark-6">
          Above and Beyond Home Solutions is owner-operated. {INSPECTOR.name} performs every inspection personally, from
          the roof and attic to the crawlspace and electrical panel, and writes every report. The person you speak with
          when you book is the person who shows up, and the person who answers your questions after you have read the findings.
        </p>
        <p class="mb-8 text-base leading-relaxed text-body-color dark:text-dark-6">
          Based in North Port and working only in Sarasota and Charlotte County, {INSPECTOR.name} inspects the housing stock
          this area actually has: 1970s and 1980s block homes, post-Ian roofs, new builds in Wellen Park, canal-front
          properties and seasonal homes that sit empty for months. Florida Home Inspector License {INSPECTOR.license}.
        </p>

        <ul class="mb-8 grid gap-3 sm:grid-cols-2">
          {INSPECTOR.credentials.map((c) => (
            <li class="flex items-start gap-3 text-base text-dark dark:text-white">
              <svg class="mt-1 h-5 w-5 flex-shrink-0 text-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 111.42-1.42L8.5 12.09l6.79-6.8a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>{c}</span>
            </li>
          ))}
        </ul>

        <div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {stats.map((s) => (
            <div class="rounded-lg bg-gray-1 p-4 text-center dark:bg-dark-2">
              <span class="block text-xl font-bold text-dark dark:text-white">{s.value}</span>
              <span class="block text-xs text-body-color dark:text-dark-6">{s.label}</span>
            </div>
          ))}
        </div>

        <div class="flex flex-wrap gap-4">
          <a href="/schedule" class="inline-flex items-center justify-center rounded-md bg-primary px-7 py-3 text-base font-medium text-white hover:bg-blue-dark">
            Schedule an Inspection
          </a>
          <a href={`tel:${BUSINESS.phone}`} class="inline-flex items-center justify-center rounded-md border border-stroke px-7 py-3 text-base font-medium text-dark hover:border-primary hover:text-primary dark:border-dark-3 dark:text-white">
            Call {BUSINESS.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== Inspector Bio Section End -->
