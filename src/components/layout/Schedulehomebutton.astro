<!-- ====== Schedule Home Inspection Button Start -->
<a
  id="scheduleFab"
  class="pointer-events-none fixed bottom-8 left-4 z-[999] inline-flex items-center gap-[10px] rounded-lg bg-white px-[14px] py-2 opacity-0 shadow-2 transition-opacity duration-300 dark:bg-dark-2 sm:left-9"
  href="/schedule"
>
  <span class="text-base font-medium text-dark-3 dark:text-dark-6">
    Schedule Home Inspection
  </span>
</a>
<script is:inline>
  (function () {
    var fab = document.getElementById('scheduleFab');
    if (!fab) return;
    var hero = document.getElementById('home');
    var threshold = hero ? hero.offsetHeight * 0.8 : 400;
    function update() {
      var show = window.scrollY > threshold;
      fab.classList.toggle('opacity-0', !show);
      fab.classList.toggle('pointer-events-none', !show);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
<!-- ====== Schedule Home Inspection Button End -->
