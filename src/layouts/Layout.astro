---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import BackToTop from '../components/layout/BackToTop.astro';
import Schedulehomebutton from '../components/layout/Schedulehomebutton.astro';
import '@fontsource-variable/inter/wght.css';

interface Props {
  description: string;
  title: string;
  image?: string;
}

const DEFAULT_OG = 'https://abovebeyondhomesolutions.com/assets/og-image.jpg';
const { description, title, image = DEFAULT_OG } = Astro.props;
// Social crawlers need absolute URLs; pages may pass a site-relative path.
const imageUrl = new URL(image, 'https://abovebeyondhomesolutions.com').href;
const isDefaultOg = imageUrl === DEFAULT_OG;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2JD6YT1C96"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-2JD6YT1C96');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Above and Beyond Home Solutions" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description.length > 125 ? description.slice(0, 122) + '...' : description} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    {isDefaultOg && <meta property="og:image:width" content="1200" />}
    {isDefaultOg && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@abovebeyondhomesolutions" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description.length > 125 ? description.slice(0, 122) + '...' : description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://abovebeyondhomesolutions.com/#business",
      "name": "Above and Beyond Home Solutions, LLC",
      "alternateName": "Above & Beyond Home Solutions",
      "url": "https://abovebeyondhomesolutions.com",
      "logo": "https://abovebeyondhomesolutions.com/assets/logo/logo.svg",
      "image": [
        "https://abovebeyondhomesolutions.com/assets/hero/hero-1920.webp",
        "https://abovebeyondhomesolutions.com/assets/about/about-image-01.webp",
        "https://abovebeyondhomesolutions.com/assets/og-image.jpg"
      ],
      "priceRange": "$475 - $950",
      "telephone": "+12394163505",
      "email": "info@abovebeyondhomesolutions.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "North Port",
        "addressRegion": "FL",
        "postalCode": "34287",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 27.0661,
        "longitude": -82.1886
      },
      "areaServed": [
        { "@type": "City", "name": "North Port", "containedInPlace": { "@type": "AdministrativeArea", "name": "Sarasota County, FL" } },
        { "@type": "City", "name": "Port Charlotte", "containedInPlace": { "@type": "AdministrativeArea", "name": "Charlotte County, FL" } },
        { "@type": "City", "name": "Punta Gorda", "containedInPlace": { "@type": "AdministrativeArea", "name": "Charlotte County, FL" } },
        { "@type": "City", "name": "Venice", "containedInPlace": { "@type": "AdministrativeArea", "name": "Sarasota County, FL" } },
        { "@type": "City", "name": "Englewood", "containedInPlace": { "@type": "AdministrativeArea", "name": "Sarasota County, FL" } },
        { "@type": "City", "name": "Rotonda West", "containedInPlace": { "@type": "AdministrativeArea", "name": "Charlotte County, FL" } },
        { "@type": "City", "name": "Nokomis", "containedInPlace": { "@type": "AdministrativeArea", "name": "Sarasota County, FL" } },
        { "@type": "City", "name": "Sarasota", "containedInPlace": { "@type": "AdministrativeArea", "name": "Sarasota County, FL" } },
        { "@type": "Place", "name": "Wellen Park", "containedInPlace": { "@type": "AdministrativeArea", "name": "Sarasota County, FL" } }
      ],
      "description": "InterNACHI certified home inspectors serving Southwest Florida. General home inspections, 4-Point, Wind Mitigation, Lateral Sewer Scope, Water and Air Quality Sampling, and Home Watch services. Same-day digital reports.",
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "credentialCategory": "license",
          "name": "Florida Home Inspector License",
          "identifier": "HI16270",
          "recognizedBy": { "@type": "GovernmentOrganization", "name": "Florida Department of Business and Professional Regulation" }
        },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "InterNACHI Certified Professional Inspector" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "IAC2 Certified Inspector" },
        { "@type": "EducationalOccupationalCredential", "credentialCategory": "certification", "name": "CCPIA Certified Inspector" }
      ],
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
          "opens": "08:00",
          "closes": "20:00"
        }
      ],
      "sameAs": [
        "https://www.facebook.com/abovebeyondhomeinspector",
        "https://www.instagram.com/abovebeyondhomesolutions",
        "https://www.nachi.org/certified-inspectors/yevgen-zakarukin-cmi-205777",
        "https://www.bbb.org/us/fl/lehigh-acres/profile/home-inspection/above-and-beyond-home-solutions-llc-0653-90436242",
        "https://www.zillow.com/profile/flhomeinspector",
        "https://www.trustpilot.com/review/abovebeyondhomesolutions.com",
        "https://www.yelp.com/biz/above-and-beyond-home-solutions-lehigh-acres-2",
        "https://nextdoor.com/pages/above-and-beyond-home-solutios-llc-lehigh-acres-fl/",
        "https://www.northportareachamber.com/list/member/above-and-beyond-home-solutions-llc-4374"
      ]
    }
    </script>
  </head>
  <body>
    <Header />
    <!-- <Header client:load /> -->
    <main>
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <Schedulehomebutton />
    <style is:global>
      html, body {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        font-family: "Inter Variable", "Inter", sans-serif;
      }
      html:not(.dark) body {
        background-color: #E3E9F3;
      }
      .sticky-header {
        @apply fixed z-[9999] bg-white/80 dark:bg-dark/80 transition;
        backdrop-filter: blur(5px);
        box-shadow: inset 0 -1px 0 0 rgba(0, 0, 0, 0.1);
      }

      .sticky-header .navbar-logo {
        @apply py-2;
      }

      .sticky-header #navbarToggler span {
        @apply bg-dark dark:bg-white;
      }

      .sticky-header #navbarCollapse li > a {
        @apply text-dark dark:text-white hover:text-primary dark:hover:text-primary hover:opacity-100;
      }
      #navbarCollapse li .ud-menu-scroll.active {
        @apply opacity-70;
      }
      .sticky-header #navbarCollapse li .ud-menu-scroll.active {
        @apply text-primary opacity-100;
      }
      .sticky-header .loginBtn {
        @apply text-dark dark:text-white hover:text-primary dark:hover:text-primary hover:opacity-100;
      }

      .sticky-header .signUpBtn {
        @apply bg-primary text-white hover:bg-blue-dark hover:text-white;
      }

      .sticky-header #themeSwitcher span {
        @apply text-dark dark:text-white;
      }

      .navbarTogglerActive > span:nth-child(1) {
        @apply top-[7px] rotate-45 transform;
      }
      .navbarTogglerActive > span:nth-child(2) {
        @apply opacity-0;
      }
      .navbarTogglerActive > span:nth-child(3) {
        @apply top-[-8px] rotate-[135deg];
      }

      .common-carousel .swiper-button-next:after,
      .common-carousel .swiper-button-prev:after {
        @apply hidden;
      }

      .common-carousel .swiper-button-next,
      .common-carousel .swiper-button-prev {
        @apply !static h-12 w-12 rounded-lg bg-white dark:bg-dark shadow-testimonial-btn text-dark dark:text-white m-0 ease-out duration-200 hover:bg-primary hover:text-white hover:shadow-none;
      }

      .common-carousel .swiper-button-next svg,
      .common-carousel .swiper-button-prev svg {
        @apply w-auto h-auto;
      }

    </style>
    <script>
      import "../scripts/stickymenu.js";
      import "../scripts/dropdown.js";
      import "../scripts/darkMode.js";
      import "../scripts/scrolltop.js";
      import "../scripts/scrollmenu.js";
      import "../scripts/testimonial.js";
    </script>
  </body>
</html>
