---
import Breadcrumb from '../components/layout/Breadcrumb.astro';
import CTAsection from '../components/CTAsection.astro';
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'General Home Inspection',
    description: 'Full inspection of roof, structure, electrical, plumbing, HVAC, interior, and exterior. Detailed digital report with photos delivered the same day.',
    href: '/generalhomeinspection',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>`,
  },
  {
    title: '4-Point & Wind Mitigation',
    description: 'Most Englewood homes 20+ years old need these reports for insurance. We deliver insurer-accepted 4-point and wind mitigation inspections that help you get coverage and earn credits.',
    href: '/4pointandwind',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
  },
  {
    title: 'Lateral Sewer Scope',
    description: 'Camera inspection of the sewer lateral from home to street. Valuable in Englewood\'s established neighborhoods where mature trees and older lines cause root intrusion.',
    href: '/services/lateral-sewer-scope',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`,
  },
  {
    title: 'Home Watch Services',
    description: 'Scheduled property checks with photo reports for seasonal residents. Englewood\'s large snowbird community makes this one of our most requested local services.',
    href: '/services/home-watch',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`,
  },
];

const commonIssues = [
  {
    issue: 'Aging Roofs & Insurer Requirements',
    detail: 'Much of Englewood was built out from the 1960s through the 1990s, so a large share of local roofs are at or past the age where Florida insurers require a 4-Point inspection or decline new coverage. We document age, condition, and material clearly for underwriting.',
  },
  {
    issue: 'Hurricane Ian Repairs',
    detail: 'Englewood was hit hard by Hurricane Ian in 2022. Many homes have had roofs, soffits, screens, and interiors repaired since. We look for incomplete repairs, improper patching, and moisture that was sealed in rather than dried out.',
  },
  {
    issue: 'Coastal Salt Air & Waterfront Wear',
    detail: 'Between Lemon Bay and Manasota Key, salt air accelerates corrosion on fasteners, HVAC equipment, and exterior finishes. On waterfront properties we also evaluate the visible condition of docks and seawalls.',
  },
  {
    issue: 'Older Cottages & Original Systems',
    detail: 'Englewood still has homes and cottages dating to its early growth era, including the historic Dearborn Street area. Original wiring, plumbing, and structural elements in these homes need a careful, unhurried look.',
  },
  {
    issue: 'Wells, Septic & Drainage',
    detail: 'Some Englewood-area properties rely on private wells and septic systems, and low-lying lots can hold water. We note drainage patterns and can add water testing when the home is on a well.',
  },
  {
    issue: 'Seasonal Home Deferred Maintenance',
    detail: 'Many Englewood homes sit vacant for months at a time. Pest activity, biological growth from HVAC failures, roof wear, and slow leaks accumulate quietly in an empty house. We flag all of it.',
  },
];

const faqs = [
  {
    q: 'Is Englewood in Sarasota County or Charlotte County?',
    a: 'Both. Englewood is unincorporated and spans the county line: the older core around Dearborn Street and West Englewood fall in Sarasota County, while East Englewood and the neighborhoods toward Rotonda West fall in Charlotte County. It matters for taxes, flood information, and especially permit records, which live with whichever county the parcel is in. We tell you which county your prospective home reports to.',
  },
  {
    q: 'Who issues building permits for Englewood homes?',
    a: 'It depends on the parcel. Sarasota County handles permits for the Sarasota County side, and Charlotte County Building Construction Services covers the Charlotte County side, which also maintains an Englewood office on San Casa Drive for residential permitting. Both counties offer online permit searches, and checking them is the fastest way to confirm a roof replacement or addition was done legitimately.',
  },
  {
    q: 'Do I need a 4-point inspection to insure an Englewood home?',
    a: 'If the home is more than 20 years old, plan on it. Citizens Property Insurance requires a 4-point inspection for homes over 20 years old, completed within the last 12 months, and most private Florida carriers have similar rules. Given Englewood\'s housing stock, that covers most local purchases. We deliver 4-point reports in the format insurers accept.',
  },
  {
    q: 'Can a wind mitigation inspection lower my premium in Englewood?',
    a: 'Frequently, yes. Florida law (section 627.0629, Florida Statutes) requires insurers to apply premium credits for verified wind-resistant features, documented on the OIR-B1-1802 form, which is generally valid for up to five years. Homes re-roofed after Hurricane Ian often qualify for stronger credits than before, because the new roof went on under current code.',
  },
  {
    q: 'Who actually performs the inspection?',
    a: 'Eugene, the owner of Above and Beyond Home Solutions, personally performs every inspection under Florida Home Inspector License HI16270. Based in nearby North Port, he covers all of Englewood, Manasota Key, and Rotonda West, and delivers a full digital report the same day.',
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
});
---

<Layout
  title="Home Inspector in Englewood, FL | Above and Beyond Home Solutions"
  description="Licensed home inspector serving Englewood, FL. General inspections, 4-point, wind mitigation, sewer scope & home watch. InterNACHI certified, same-day reports."
>
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Home Inspection in Englewood, FL",
    "serviceType": "Home Inspection",
    "description": "Professional home inspections serving Englewood, Florida. General home inspection, 4-point, wind mitigation, lateral sewer scope, and home watch services. InterNACHI certified inspector, same-day digital reports.",
    "provider": {
      "@type": "ProfessionalService",
      "name": "Above and Beyond Home Solutions, LLC",
      "url": "https://abovebeyondhomesolutions.com",
      "telephone": "+12394163505",
      "license": "Florida Home Inspector License HI16270"
    },
    "areaServed": {
      "@type": "City",
      "name": "Englewood",
      "containedInPlace": {
        "@type": "State",
        "name": "Florida"
      }
    },
    "url": "https://abovebeyondhomesolutions.com/home-inspector-englewood"
  }
  </script>

  <script type="application/ld+json" is:inline set:html={faqSchema} />

  <Breadcrumb>
    <Fragment slot="title">Home Inspector in Englewood, FL</Fragment>
  </Breadcrumb>

  <!-- Hero -->
  <section class="bg-white dark:bg-dark py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <span class="mb-4 inline-block rounded-full bg-primary/10 px-4 py-1.5 text-sm font-semibold text-primary">
          Sarasota & Charlotte County · Englewood, FL
        </span>
        <h1 class="mb-5 text-4xl font-extrabold tracking-tight text-dark dark:text-white sm:text-5xl">
          Home Inspector in Englewood, FL
        </h1>
        <p class="mb-8 text-lg leading-relaxed text-body-color dark:text-dark-6">
          Above and Beyond Home Solutions provides thorough, same-day home inspections throughout Englewood, from the historic Dearborn Street district to Manasota Key and East Englewood. Eugene, the owner and licensed inspector (HI16270), personally performs every inspection, minutes from our North Port home base.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/schedule"
            class="inline-flex items-center justify-center rounded-md bg-primary px-8 py-4 text-base font-semibold text-white shadow-sm transition-all duration-300 hover:-translate-y-[1px] hover:bg-blue-dark hover:shadow-md"
          >
            Book Your Englewood Inspection
          </a>
          <a
            href="tel:+12394163505"
            class="inline-flex items-center justify-center rounded-md border border-primary/30 px-8 py-4 text-base font-semibold text-primary transition-all duration-300 hover:bg-primary/5"
          >
            Call (239) 416-3505
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Signals -->
  <section class="bg-slate-50 dark:bg-dark-2 py-10">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        {[
          { label: 'InterNACHI Certified', icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>` },
          { label: 'License #HI16270', icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>` },
          { label: 'Same-Day Reports', icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>` },
          { label: 'Locally Owned', icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>` },
        ].map(item => (
          <div class="flex flex-col items-center gap-2 rounded-xl bg-white dark:bg-dark p-4 text-center shadow-sm">
            <svg class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={item.icon} />
            <span class="text-sm font-semibold text-dark dark:text-white">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-white dark:bg-dark py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="mb-4 text-3xl font-bold text-dark dark:text-white sm:text-4xl">
          Inspection Services in Englewood
        </h2>
        <p class="text-base text-body-color dark:text-dark-6">
          From buyer's inspections to insurance-required reports and seasonal home monitoring, we cover what Englewood homeowners need.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {services.map(service => (
          <a
            href={service.href}
            class="group flex flex-col rounded-xl border border-stroke bg-white dark:border-dark-3 dark:bg-dark-2 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-primary/30"
          >
            <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors duration-300">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={service.icon} />
            </div>
            <h3 class="mb-2 text-lg font-semibold text-dark dark:text-white">{service.title}</h3>
            <p class="flex-1 text-sm text-body-color dark:text-dark-6">{service.description}</p>
            <span class="mt-4 text-sm font-semibold text-primary">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Common Issues -->
  <section class="bg-slate-50 dark:bg-dark-2 py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="mb-4 text-3xl font-bold text-dark dark:text-white sm:text-4xl">
          Common Issues Found in Englewood Homes
        </h2>
        <p class="text-base text-body-color dark:text-dark-6">
          Englewood's mix of older coastal homes, storm history, and seasonal properties creates a distinct set of inspection findings.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {commonIssues.map(item => (
          <div class="rounded-xl border border-stroke bg-white dark:border-dark-3 dark:bg-dark p-6 shadow-sm">
            <div class="mb-3 flex items-center gap-3">
              <div class="h-2.5 w-2.5 rounded-full bg-primary flex-shrink-0"></div>
              <h3 class="font-semibold text-dark dark:text-white">{item.issue}</h3>
            </div>
            <p class="text-sm text-body-color dark:text-dark-6">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Inspect in Englewood -->
  <section class="bg-white dark:bg-dark py-16 lg:py-20">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-6 text-3xl font-bold text-dark dark:text-white">
          Why Home Inspections Matter in Englewood
        </h2>
        <div class="space-y-4 text-base leading-relaxed text-body-color dark:text-dark-6">
          <p>
            Englewood grew up as an old Florida coastal town, with most of its expansion coming from the 1960s onward, and it still shows that history in the best way. Original cottages near Dearborn Street sit a short drive from 1970s and 1980s canal homes and newer construction toward Rotonda West. That range of age and condition is exactly why an independent inspection matters here: no two Englewood homes are in the same shape.
          </p>
          <p>
            The town also straddles two counties. A home a few blocks from the county line can have its permits, flood data, and records in either Sarasota County or Charlotte County, and buyers rarely know which until they ask. We work both sides of the line every week, and we point you to the right permit office when something on the property deserves a records check.
          </p>
          <p>
            Hurricane Ian left a real mark on Englewood in 2022. Plenty of local homes have new roofs, screens, and repairs, and most of that work was done well. Some of it was not. We look closely at repair quality, check for moisture that got sealed behind new finishes, and document what an insurer or a future buyer will want to know.
          </p>
          <p>
            We serve all of Englewood including Manasota Key, East Englewood, Grove City, and neighboring <a href="/home-inspector-port-charlotte" class="text-primary hover:underline">Port Charlotte</a> and Rotonda West. Our <a href="/generalhomeinspection" class="text-primary hover:underline">general home inspection</a>, <a href="/4pointandwind" class="text-primary hover:underline">4-point and wind mitigation inspections</a>, <a href="/services/lateral-sewer-scope" class="text-primary hover:underline">lateral sewer scope</a>, and <a href="/services/home-watch" class="text-primary hover:underline">home watch service</a> are all available throughout the Englewood area.
          </p>
        </div>
        <div class="mt-8">
          <a
            href="/schedule"
            class="inline-flex items-center justify-center rounded-md bg-primary px-8 py-4 text-base font-semibold text-white shadow-sm transition-all duration-300 hover:-translate-y-[1px] hover:bg-blue-dark hover:shadow-md"
          >
            Schedule Your Englewood Inspection
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-slate-50 dark:bg-dark-2 py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="mb-4 text-3xl font-bold text-dark dark:text-white sm:text-4xl">
          Englewood Home Inspection FAQs
        </h2>
        <p class="text-base text-body-color dark:text-dark-6">
          The questions Englewood buyers and homeowners ask us most.
        </p>
      </div>
      <div class="mx-auto max-w-3xl space-y-6">
        {faqs.map(faq => (
          <div class="rounded-xl border border-stroke bg-white dark:border-dark-3 dark:bg-dark p-6 shadow-sm">
            <h3 class="mb-2 text-lg font-semibold text-dark dark:text-white">{faq.q}</h3>
            <p class="text-base text-body-color dark:text-dark-6">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTAsection />
</Layout>
