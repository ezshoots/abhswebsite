---
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import CTAsection from '../../components/CTAsection.astro';
import Layout from '../../layouts/Layout.astro';

const triggers = [
  {
    title: 'Past Water Damage or Repairs',
    description:
      'Stained ceilings, swollen baseboards, patched drywall, or a disclosed leak are signs that moisture was once present. Even after the visible damage is repaired, mold can remain behind walls, under flooring, or in the attic. Air sampling shows whether spore levels inside the home are elevated.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>`,
  },
  {
    title: 'Storm or Flood History',
    description:
      'Homes that took on water during Ian, Helene, Milton, or any storm event are prime candidates for sampling. Mold can begin growing within 24 to 48 hours of water intrusion, and a quick cosmetic repair before a sale does not tell you what happened inside the wall cavity.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>`,
  },
  {
    title: 'Musty Odors or High Humidity',
    description:
      'A musty smell, condensation on windows or ducts, or elevated moisture meter readings during the inspection often point to a hidden source. Sampling helps confirm whether those conditions have already led to elevated airborne spores.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m1.636-6.364l.707.707M12 21v-1m-6.364-1.636l.707-.707M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>`,
  },
  {
    title: 'Post-Remediation Clearance',
    description:
      'After mold remediation is completed, a clearance air test confirms that indoor spore levels have returned to normal compared with outdoor air. You receive lab documentation you can share with your insurer, buyer, or lender.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
  },
];

const steps = [
  {
    number: '01',
    title: 'Inspect & Choose Locations',
    description:
      'We look for signs of past or active moisture, take moisture meter readings, and select sample locations in the rooms of concern. Sampling can be added to a home inspection or booked on its own.',
  },
  {
    number: '02',
    title: 'Air-O-Cell Sampling',
    description:
      'A calibrated pump draws a measured volume of air through a sealed Air-O-Cell cassette, which captures airborne spores and particles. An outdoor control sample is collected at the same visit as a baseline.',
  },
  {
    number: '03',
    title: 'Lab Analysis & Report',
    description:
      'Cassettes go to an accredited laboratory, which identifies spore types and reports concentrations in spores per cubic meter. We explain the results in plain language, comparing indoor levels to the outdoor baseline.',
  },
];
---

<Layout
  title="Mold Air Quality Testing | Above and Beyond Home Solutions"
  description="Air-O-Cell mold spore sampling in North Port, Port Charlotte, Punta Gorda, Venice and Sarasota for homes with past water damage. Well water sampling available on request."
>
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Mold & Air Quality Testing",
    "serviceType": "Mold Air Sampling",
    "description": "Air-O-Cell cassette sampling to measure airborne mold spore concentrations in Southwest Florida homes with signs of past moisture damage, storm or flood history, or completed remediation. Indoor results are compared to an outdoor baseline and analyzed by an accredited laboratory. Well water sampling is available on request.",
    "provider": {
      "@type": "ProfessionalService",
      "@id": "https://abovebeyondhomesolutions.com/#business",
      "name": "Above and Beyond Home Solutions, LLC",
      "url": "https://abovebeyondhomesolutions.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "8896 Wawana Rd",
        "addressLocality": "North Port",
        "addressRegion": "FL",
        "postalCode": "34287",
        "addressCountry": "US"
      }    },
    "areaServed": ["North Port, FL","Port Charlotte, FL","Punta Gorda, FL","Venice, FL","Englewood, FL","Rotonda West, FL","Nokomis, FL","Sarasota, FL"],
    "url": "https://abovebeyondhomesolutions.com/services/water-air-quality"
  }
  </script>
  <Breadcrumb pageTitle="Air Quality & Mold Sampling">
    <Fragment slot="title">Air Quality & Mold Sampling</Fragment>
  </Breadcrumb>

  <!-- ====== Overview Section Start -->
  <section class="py-20 dark:bg-dark lg:py-[120px]">
    <div class="container">
      <div class="-mx-4 flex flex-wrap items-center">

        <!-- Text column -->
        <div class="w-full px-4 lg:w-1/2">
          <div class="mb-12 lg:mb-0 lg:pr-10">
            <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-1 text-sm font-semibold text-primary">
              Mold Air Sampling
            </span>
            <h2 class="mb-5 mt-3 text-3xl font-bold text-dark dark:text-white sm:text-4xl md:text-[42px] md:leading-[1.15]">
              Find Out What's in the Air Before You Buy
            </h2>
            <p class="mb-5 text-base leading-relaxed text-body-color dark:text-dark-6">
              Water stains, patched drywall, or a history of leaks tell you moisture was once inside the home. What they don't tell you is whether mold is still growing where you can't see it. When we find signs of past moisture damage, we use Air-O-Cell cassettes to measure the concentration of mold spores in the air and compare it to an outdoor baseline.
            </p>
            <p class="mb-8 text-base leading-relaxed text-body-color dark:text-dark-6">
              Whether you're buying in Sarasota, North Port, Venice, or Englewood, or you own a home in Port Charlotte or Punta Gorda that took on water during a storm, lab-analyzed air samples give you real numbers to make decisions with, not guesses.
            </p>
            <a
              href="/schedule"
              class="inline-flex items-center justify-center rounded-md bg-primary px-7 py-3 text-base font-medium text-white shadow-sm transition-all duration-300 ease-in-out hover:-translate-y-[1px] hover:bg-blue-dark hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
            >
              Schedule Testing
            </a>
          </div>
        </div>

        <!-- Image / stat column -->
        <div class="w-full px-4 lg:w-1/2">
          <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary/10 to-primary/5 p-1 ring-1 ring-primary/20 dark:from-primary/20 dark:to-primary/10">
            <img
              src="/assets/blog/baseboard-water-staining-tile-floor.webp"
              width="1200"
              height="900"
              alt="Water staining along a baseboard above a tile floor, a sign of past moisture damage that calls for mold air sampling"
              class="w-full rounded-xl object-cover"
              style="aspect-ratio: 16/10;"
            />
          </div>

          <!-- Info strip -->
          <div class="mt-6 grid grid-cols-3 divide-x divide-stroke dark:divide-dark-3 rounded-xl border border-stroke dark:border-dark-3 bg-white dark:bg-dark-2">
            <div class="px-5 py-4 text-center">
              <p class="text-2xl font-bold text-dark dark:text-white">Lab</p>
              <p class="mt-1 text-xs text-body-color dark:text-dark-6">Analyzed Results</p>
            </div>
            <div class="px-5 py-4 text-center">
              <p class="text-2xl font-bold text-dark dark:text-white">Indoor</p>
              <p class="mt-1 text-xs text-body-color dark:text-dark-6">vs. Outdoor Baseline</p>
            </div>
            <div class="px-5 py-4 text-center">
              <p class="text-2xl font-bold text-dark dark:text-white">Add-On</p>
              <p class="mt-1 text-xs text-body-color dark:text-dark-6">Available</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
  <!-- ====== Overview Section End -->

  <!-- ====== When To Test Section Start -->
  <section class="bg-gray-1 py-20 dark:bg-dark-2 lg:py-[120px]">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center lg:mb-[70px]">
        <span class="mb-3 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-1 text-sm font-semibold text-primary">
          When to Test
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-dark dark:text-white sm:text-4xl md:text-[42px] md:leading-[1.15]">
          When We Recommend Air Sampling
        </h2>
        <p class="mt-4 text-base leading-relaxed text-body-color dark:text-dark-6">
          A home inspection can identify moisture damage, but it cannot tell you how many mold spores are in the air. These are the situations where sampling is worth adding.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
        {triggers.map((item) => (
          <div class="group rounded-2xl border border-black/5 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:ring-1 hover:ring-primary/20 dark:border-white/10 dark:bg-dark">
            <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 ring-1 ring-primary/20 transition-transform duration-300 group-hover:scale-[1.05]">
              <svg
                class="h-6 w-6 text-primary"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <Fragment set:html={item.icon} />
              </svg>
            </div>
            <h3 class="mb-3 text-lg font-semibold text-dark dark:text-white">{item.title}</h3>
            <p class="text-sm leading-relaxed text-body-color dark:text-dark-6">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <!-- ====== When To Test Section End -->

  <!-- ====== How It Works Section Start -->
  <section class="py-20 dark:bg-dark lg:py-[120px]">
    <div class="container">
      <div class="mx-auto mb-12 max-w-2xl text-center lg:mb-[70px]">
        <span class="mb-3 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-4 py-1 text-sm font-semibold text-primary">
          Air-O-Cell Sampling
        </span>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-dark dark:text-white sm:text-4xl md:text-[42px] md:leading-[1.15]">
          How It Works
        </h2>
        <p class="mt-4 text-base leading-relaxed text-body-color dark:text-dark-6">
          Air-O-Cell cassettes are an industry-standard method for spore trap sampling. Here's what happens from the visit to your results.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {steps.map((step) => (
          <div class="relative text-center">
            <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 ring-2 ring-primary/20">
              <span class="text-2xl font-bold text-primary">{step.number}</span>
            </div>
            <h3 class="mb-3 text-xl font-semibold text-dark dark:text-white">{step.title}</h3>
            <p class="text-sm leading-relaxed text-body-color dark:text-dark-6">{step.description}</p>
          </div>
        ))}
      </div>

      <div class="mx-auto mt-12 max-w-xl text-center">
        <a
          href="/schedule"
          class="inline-flex items-center justify-center rounded-md bg-primary px-8 py-3 text-base font-medium text-white shadow-sm transition-all duration-300 ease-in-out hover:-translate-y-[1px] hover:bg-blue-dark hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
        >
          Schedule Air Sampling
        </a>
      </div>

      <!-- Well water callout -->
      <div class="mx-auto mt-16 max-w-3xl rounded-2xl border border-secondary/30 bg-secondary/10 px-8 py-6 text-center">
        <p class="text-lg font-semibold text-dark dark:text-white">Have a Private Well?</p>
        <p class="mt-2 text-base text-body-color dark:text-dark-6">
          We also offer well water sampling for homes on private wells, which are common in rural parts of Sarasota, Charlotte, and DeSoto counties. Contact us to talk through what testing makes sense for your property.
        </p>
        <a href="/contact" class="mt-4 inline-block font-semibold text-primary hover:underline">Contact us about well water sampling</a>
      </div>
    </div>
  </section>
  <!-- ====== How It Works Section End -->

  <CTAsection />
</Layout>
